# ===== Database (PostgreSQL) =====
# Uses your LOCAL PostgreSQL 17 (Windows service: postgresql-x64-17) on port 5432.
# Replace YOUR_PASSWORD with your postgres user password.
#
# IMPORTANT: if your password contains special characters, URL-encode them:
#   @  -> %40      #  -> %23      :  -> %3A      /  -> %2F
#   ?  -> %3F      &  -> %26      =  -> %3D      %  -> %25
#   space -> %20   +  -> %2B
# Example: password "Ma@in#2026" becomes "Ma%40in%232026"
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/momai_shop?schema=public"

# ===== Auth / Security =====
# Secret used to sign the JWT session cookie. Use a long random string (>=32 chars).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"

# ===== Admin account (created by the seed script) =====
ADMIN_EMAIL="admin@momaitraders.in"
ADMIN_PASSWORD="ChangeMe123!"

# ===== Image uploads + stamped-copy archive (Cloudinary free tier) =====
# Used for product image uploads AND for archiving stamped invoice/challan copies.
# Optional for images (falls back to local /uploads storage), but required for
# the "Upload stamped copy" buttons on the admin order page.
# Sign up free at cloudinary.com and copy the values from the Dashboard
# (console.cloudinary.com -> Account Details). See CLOUDINARY-SETUP.md.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ===== Email notifications (SMTP) =====
# Used to email quote requests (with Excel attachment) and order notifications.
# Example: Gmail with an App Password.
#   1. Enable 2-Step Verification on your Google account.
#   2. Create an App Password: https://myaccount.google.com/apppasswords
#   3. Set SMTP_USER to your full Gmail address and SMTP_PASS to the 16-char app password.
# Copy these into your .env file and fill in the real values.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Momai Traders"

# Recipient address for quote request notifications.
# If unset, the "Email" value in Site Settings (default momaitraders73@gmail.com) is used.
NOTIFY_EMAIL=""

# ===== Site config =====
# Base URL of the deployed site (used for links in emails/invoices).
SITE_URL="http://localhost:3000"
